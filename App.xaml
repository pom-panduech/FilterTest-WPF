<Application x:Class="ModbusChart.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ═══════════════════════════════════════════
             LFT MONITOR — COLOR PALETTE
        ═══════════════════════════════════════════ -->
        <!-- Dark navy chrome -->
        <SolidColorBrush x:Key="BrBgDeep"      Color="#0B1929"/>
        <SolidColorBrush x:Key="BrBgDark"      Color="#0D1E35"/>
        <SolidColorBrush x:Key="BrBgPanel"     Color="#0F2340"/>
        <SolidColorBrush x:Key="BrBgCard"      Color="#0D1E35"/>
        <SolidColorBrush x:Key="BrBgInput"     Color="#152845"/>
        <SolidColorBrush x:Key="BrBgHover"     Color="#1A3050"/>
        <SolidColorBrush x:Key="BrBgSelect"    Color="#1E3A5F"/>
        <SolidColorBrush x:Key="BrBorder"      Color="#1E3A5F"/>
        <SolidColorBrush x:Key="BrBorderFocus" Color="#00ACC1"/>
        <!-- Text on dark bg -->
        <SolidColorBrush x:Key="BrText1"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrText2"       Color="#8BA7C0"/>
        <SolidColorBrush x:Key="BrText3"       Color="#4A6880"/>
        <!-- Accent colors -->
        <SolidColorBrush x:Key="BrBlue"        Color="#1565C0"/>
        <SolidColorBrush x:Key="BrTeal"        Color="#00ACC1"/>
        <SolidColorBrush x:Key="BrGreen"       Color="#43A047"/>
        <SolidColorBrush x:Key="BrRed"         Color="#E53935"/>
        <SolidColorBrush x:Key="BrOrange"      Color="#F57C00"/>
        <!-- Light chart / form area -->
        <SolidColorBrush x:Key="BrChartBg"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrFormBg"      Color="#EEF2F7"/>
        <SolidColorBrush x:Key="BrFormBorder"  Color="#C8D6E5"/>
        <SolidColorBrush x:Key="BrFormText"    Color="#2C3E50"/>
        <!-- Aliases -->
        <SolidColorBrush x:Key="BrTextPrimary"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrTextSecondary" Color="#8BA7C0"/>
        <SolidColorBrush x:Key="BrAccentBlue"    Color="#1565C0"/>
        <SolidColorBrush x:Key="BrAccentGreen"   Color="#43A047"/>
        <SolidColorBrush x:Key="BrAccentRed"     Color="#E53935"/>

        <!-- ═══════════════════════════════════════════
             GLOBAL FONT
        ═══════════════════════════════════════════ -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- ═══════════════════════════════════════════
             THIN SCROLLBAR
        ═══════════════════════════════════════════ -->
        <Style x:Key="SlimThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="#601E3A5F"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VertScrollBarTemplate" TargetType="ScrollBar">
            <Border Background="Transparent" Width="5" Padding="0,4">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource SlimThumb}" MinHeight="20"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"      Value="5"/>
            <Setter Property="MinWidth"   Value="5"/>
            <Setter Property="Template"   Value="{StaticResource VertScrollBarTemplate}"/>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
        </Style>

        <!-- ═══════════════════════════════════════════
             BUTTON — rounded modern
        ═══════════════════════════════════════════ -->
        <ControlTemplate x:Key="ModernBtn" TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.80"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.60"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Button">
            <Setter Property="Background"      Value="#1A3050"/>
            <Setter Property="Foreground"      Value="{StaticResource BrText1}"/>
            <Setter Property="BorderBrush"     Value="#2A4070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template"        Value="{StaticResource ModernBtn}"/>
        </Style>

        <!-- Green — Start -->
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"  Value="#2E7D32"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#43A047"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <!-- Accent blue -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"  Value="#1565C0"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#1E88E5"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <!-- Danger red -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"  Value="#B71C1C"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#E53935"/>
        </Style>
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource DangerButton}"/>

        <!-- ═══════════════════════════════════════════
             TEXTBOX (dark bg version)
        ═══════════════════════════════════════════ -->
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BrBgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource BrText1}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="CaretBrush"      Value="{StaticResource BrTeal}"/>
            <Setter Property="SelectionBrush"  Value="{StaticResource BrBgSelect}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrBorderFocus}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Light TextBox for form area -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="{StaticResource BrFormText}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrFormBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Stat value box on sidebar -->
        <Style x:Key="StatBox" TargetType="TextBlock">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="#1A2B3C"/>
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth"     Value="58"/>
        </Style>

        <!-- ═══════════════════════════════════════════
             COMBOBOX
        ═══════════════════════════════════════════ -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource BrBgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource BrText1}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#1A2B3C"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding"    Value="8,5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="12" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D0E4F4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B8D4F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════
             CHECKBOX / LABEL
        ═══════════════════════════════════════════ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrText1}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource BrText2}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Padding"    Value="2"/>
        </Style>

        <!-- Light label for form area -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground"       Value="#0B1929"/>
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="FontSize"         Value="10"/>
            <Setter Property="Margin"           Value="0,0,0,2"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- ═══════════════════════════════════════════
             MENU
        ═══════════════════════════════════════════ -->
        <Style TargetType="Menu">
            <Setter Property="Background"      Value="{StaticResource BrBgDeep}"/>
            <Setter Property="Foreground"      Value="{StaticResource BrText2}"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{StaticResource BrBgDeep}"/>
            <Setter Property="Foreground" Value="{StaticResource BrText1}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Padding"    Value="10,4"/>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource BrBorder}"/>
            <Setter Property="Margin"     Value="0,2"/>
            <Setter Property="Height"     Value="1"/>
        </Style>

        <!-- ═══════════════════════════════════════════
             GROUPBOX
        ═══════════════════════════════════════════ -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush"     Value="{StaticResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{StaticResource BrText2}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="Margin"          Value="0,4"/>
        </Style>

        <!-- ═══════════════════════════════════════════
             STATUS BAR
        ═══════════════════════════════════════════ -->
        <Style TargetType="StatusBar">
            <Setter Property="Background"  Value="{StaticResource BrBgDeep}"/>
            <Setter Property="Foreground"  Value="{StaticResource BrText2}"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Height"      Value="24"/>
        </Style>

        <!-- ═══════════════════════════════════════════
             TAB
        ═══════════════════════════════════════════ -->
        <Style TargetType="TabControl">
            <Setter Property="Background"  Value="{StaticResource BrBgPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background"  Value="{StaticResource BrBgDark}"/>
            <Setter Property="Foreground"  Value="{StaticResource BrText2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
            <Setter Property="Padding"     Value="14,6"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrBgPanel}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrText1}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════
             DATAGRID
        ═══════════════════════════════════════════ -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"              Value="{StaticResource BrBgPanel}"/>
            <Setter Property="Foreground"              Value="{StaticResource BrText1}"/>
            <Setter Property="BorderBrush"             Value="{StaticResource BrBorder}"/>
            <Setter Property="GridLinesVisibility"     Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrBorder}"/>
            <Setter Property="RowBackground"           Value="{StaticResource BrBgPanel}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BrBgDark}"/>
            <Setter Property="FontFamily"              Value="Segoe UI"/>
            <Setter Property="FontSize"                Value="12"/>
            <Setter Property="SelectionMode"           Value="Single"/>
            <Setter Property="CanUserAddRows"          Value="False"/>
            <Setter Property="AutoGenerateColumns"     Value="False"/>
            <Setter Property="HeadersVisibility"       Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{StaticResource BrBgDeep}"/>
            <Setter Property="Foreground"      Value="{StaticResource BrText2}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrBgHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrBgSelect}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="Foreground"      Value="{StaticResource BrText1}"/>
        </Style>

    </Application.Resources>
</Application>
