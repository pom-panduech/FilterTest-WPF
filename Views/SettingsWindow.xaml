<Window x:Class="ModbusChart.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ModbusChart.Converters"
        Title="Settings" Height="620" Width="940"
        Background="#0D1E35"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <conv:StringToColorBrushConverter x:Key="StrColor"/>

        <Style TargetType="TabItem">
            <Setter Property="Foreground"  Value="#A8C0E8"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="Padding"     Value="20,10"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent"
                                BorderThickness="0,0,0,3" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <TextBlock x:Name="txt" Text="{TemplateBinding Header}"
                                       Foreground="#A8C0E8" FontSize="13" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd"  Property="BorderBrush" Value="#4A9EE0"/>
                                <Setter TargetName="bd"  Property="Background"  Value="#122040"/>
                                <Setter TargetName="txt" Property="Foreground"  Value="#FFFFFF"/>
                                <Setter TargetName="txt" Property="FontWeight"  Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"  Property="Background"  Value="#0F1A2E"/>
                                <Setter TargetName="txt" Property="Foreground"  Value="#D0E4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="#0A1628"/>
            <Setter Property="BorderBrush"     Value="#1E3A5F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#091525"
                                    BorderBrush="#1E3A5F" BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" HorizontalAlignment="Left"/>
                            </Border>
                            <Border Grid.Row="1" Background="#0A1628"
                                    BorderBrush="#1E3A5F" BorderThickness="1,0,1,1">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#EDF2F8"/>
            <Setter Property="Foreground"      Value="#1A2B3C"/>
            <Setter Property="BorderBrush"     Value="#7A9EC0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"      Value="#1A2B3C"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4A9EE0"/>
                    <Setter Property="Background"  Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="Foreground"      Value="#1A2B3C"/>
            <Setter Property="BorderBrush"     Value="#7A9EC0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="root">
                            <!-- Full-width ToggleButton handles all click events -->
                            <ToggleButton x:Name="toggleBtn"
                                          Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1"
                                                        Background="#E8F0F8"
                                                        BorderBrush="#7A9EC0"
                                                        BorderThickness="1,0,0,0"
                                                        CornerRadius="0,3,3,0">
                                                    <TextBlock Text="▾" Foreground="#4A6880"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A9EE0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Selected item display -->
                            <TextBlock IsHitTestVisible="False"
                                       Text="{TemplateBinding SelectionBoxItem}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="11" FontFamily="Segoe UI"
                                       Margin="6,0,28,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True">
                                <Border Background="White"
                                        BorderBrush="#7A9EC0"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=root}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="toggleBtn" Property="BorderBrush" Value="#4A9EE0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"  Value="White"/>
            <Setter Property="Foreground"  Value="#1A2B3C"/>
            <Setter Property="Padding"     Value="8,5"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="11" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D0E4F4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B8D4F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"     Value="0,0,8,0"/>
        </Style>

        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin"     Value="0,0,0,14"/>
        </Style>

        <Style x:Key="UnitBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#071220"
                BorderBrush="#1E3A5F" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙" FontSize="16" Foreground="#4A9EE0"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="0">

            <!-- ══════ TAB 1: MODBUS CONNECTION ══════ -->
            <TabItem Header="  Modbus Connection  ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="Transparent">
                        <StackPanel Margin="20,16">
                            <TextBlock Text="Modbus TCP Connection" Style="{StaticResource SecTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="IP PLC" Style="{StaticResource Lbl}"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbHost" Height="28"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Port" Style="{StaticResource Lbl}"/>
                                <TextBox   Grid.Row="0" Grid.Column="4" x:Name="TbPort" Height="28"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Slave ID" Style="{StaticResource Lbl}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TbUnitId" Height="28"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Timeout (ms)" Style="{StaticResource Lbl}"/>
                                <TextBox   Grid.Row="1" Grid.Column="4" x:Name="TbTimeout" Height="28"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Poll Interval (ms)" Style="{StaticResource Lbl}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TbPollInterval" Height="28"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Test Connect — ติดล่างขวา -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,20,40">
                        <TextBlock x:Name="TbTestStatus"
                                   FontSize="12" FontFamily="Segoe UI"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button x:Name="BtnTestConnect"
                                Content="Test Connect" Width="120" Height="32"
                                Background="#1565C0" Foreground="White"
                                FontWeight="SemiBold"
                                BorderBrush="#42A5F5" BorderThickness="1"
                                Click="TestConnect_Click">
                            <Button.Effect>
                                <DropShadowEffect Color="#42A5F5" BlurRadius="18"
                                                  ShadowDepth="0" Opacity="0.85"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══════ TAB 2: CHANNELS ══════ -->
            <TabItem Header="  Channels  ">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="ChHeaderBorder" Grid.Row="0"
                            Background="#091525"
                            BorderBrush="#1E3A5F" BorderThickness="0,0,0,1"
                            Padding="16,0"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
                        <StackPanel x:Name="ChannelsPanel" Margin="16,6,16,12"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ══════ TAB 3: AXIS SCALE ══════ -->
            <TabItem Header="  Axis Scale  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel Margin="20,16">

                        <!-- Pressure axis -->
                        <TextBlock Text="Pressure Axis (Left)" Style="{StaticResource SecTitle}"
                                   Foreground="#FF9090"/>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Text="Max" Style="{StaticResource Lbl}"/>
                            <TextBox   Grid.Column="1" x:Name="TbPresMax" Height="28"/>
                            <TextBlock Grid.Column="2" Width="20"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <TextBlock Text="Divisions" Style="{StaticResource Lbl}" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CbPresDivisions" Width="70" Height="28"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#1E3A5F" Margin="0,0,0,20" Opacity="0.7"/>

                        <!-- Temp/Speed axis -->
                        <TextBlock Text="Temp / Speed Axis (Right)" Style="{StaticResource SecTitle}"
                                   Foreground="#88BBFF"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Text="Max" Style="{StaticResource Lbl}"/>
                            <TextBox   Grid.Column="1" x:Name="TbTsMax" Height="28"/>
                            <TextBlock Grid.Column="2" Width="20"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <TextBlock Text="Divisions" Style="{StaticResource Lbl}" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CbTsDivisions" Width="70" Height="28"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════ TAB 4: CHANGE UNIT ══════ -->
            <TabItem Header="  Change Unit  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel Margin="20,16">

                        <!-- Pressure -->
                        <TextBlock Text="Pressure Unit" Style="{StaticResource SecTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <RadioButton x:Name="RbBar" Content="bar"
                                         Style="{StaticResource UnitBtn}" GroupName="PressureUnit"/>
                            <RadioButton x:Name="RbPsi" Content="psi"
                                         Style="{StaticResource UnitBtn}" GroupName="PressureUnit"/>
                        </StackPanel>

                        <Border Height="1" Background="#1E3A5F" Margin="0,0,0,20" Opacity="0.7"/>

                        <!-- Temperature -->
                        <TextBlock Text="Temperature Unit" Style="{StaticResource SecTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <RadioButton x:Name="RbCelsius" Content="°C"
                                         Style="{StaticResource UnitBtn}" GroupName="TempUnit"/>
                            <RadioButton x:Name="RbFahrenheit" Content="°F"
                                         Style="{StaticResource UnitBtn}" GroupName="TempUnit"/>
                        </StackPanel>

                        <Border Height="1" Background="#1E3A5F" Margin="0,0,0,20" Opacity="0.7"/>

                        <!-- Speed -->
                        <TextBlock Text="Speed Unit" Style="{StaticResource SecTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="RbRpm" Content="RPM"
                                         Style="{StaticResource UnitBtn}" GroupName="SpeedUnit"/>
                            <RadioButton x:Name="RbCcMin" Content="cc/min"
                                         Style="{StaticResource UnitBtn}" GroupName="SpeedUnit"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#071220"
                BorderBrush="#1E3A5F" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Height="32" Margin="0,0,10,0"
                        Click="Cancel_Click"
                        Background="#1A3050" Foreground="#A8C0E8" BorderBrush="#2A4070"/>
                <Button Content="Save" Width="120" Height="32"
                        Click="Ok_Click"
                        Background="#1565C0" Foreground="White"
                        BorderBrush="#1E88E5" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
