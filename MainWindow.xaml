<Window x:Class="ModbusChart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:conv="clr-namespace:ModbusChart.Converters"
        Title="LFT Monitor"
        Height="820" Width="1300"
        MinHeight="650" MinWidth="1000"
        Background="{StaticResource BrBgDeep}"
        FontFamily="Segoe UI"
        TextElement.Foreground="{StaticResource BrText1}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <conv:BoolToVisibilityConverter       x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <conv:BoolToConnectedBrushConverter   x:Key="ConnBrush"/>
        <conv:StringToColorBrushConverter     x:Key="StrColor"/>
        <conv:BoolToOpacityConverter          x:Key="BoolOpacity"/>

        <!-- ═══ SIDEBAR STAT ROW ═══ -->
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground"       Value="#A8C0E8"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"            Value="74"/>
        </Style>

        <Style x:Key="StatUnit" TargetType="TextBlock">
            <Setter Property="Foreground"       Value="#A8C0E8"/>
            <Setter Property="FontSize"         Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"           Value="4,0,0,0"/>
        </Style>

        <!-- ═══ STAT VALUE BORDER BOX ═══ -->
        <Style x:Key="StatValueBorder" TargetType="Border">
            <Setter Property="Background"     Value="#FFFFFF"/>
            <Setter Property="BorderBrush"    Value="#B0C4D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="3"/>
            <Setter Property="Padding"        Value="4,2"/>
            <Setter Property="MinWidth"       Value="44"/>
        </Style>

        <!-- ═══ SECTION HEADER ═══ -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ═══ TOOLBAR ICON BUTTON ═══ -->
        <Style x:Key="TBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Background"      Value="#1A3050"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#1565C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground"  Value="#2A3A50"/>
                    <Setter Property="BorderBrush" Value="#1E2A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- ══════════════════════════════════════════════════════
             MENU BAR
        ══════════════════════════════════════════════════════ -->
        <Menu DockPanel.Dock="Top"
              Background="White"
              BorderBrush="#D0D8E4"
              BorderThickness="0,0,0,1"
              Padding="2,0">
            <MenuItem Background="Transparent" Padding="10,1">
                <MenuItem.Header>
                    <TextBlock Text="File" Foreground="#1A2B3C" FontSize="12" FontFamily="Segoe UI"/>
                </MenuItem.Header>
                <MenuItem Background="White" Click="New_Click">
                    <MenuItem.Header>
                        <TextBlock Text="New" Foreground="#1A2B3C" FontSize="12" FontFamily="Segoe UI"/>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Background="White" Click="OpenCsv_Click">
                    <MenuItem.Header>
                        <TextBlock Text="Open CSV..." Foreground="#1A2B3C" FontSize="12" FontFamily="Segoe UI"/>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Background="White" Click="ExportCsv_Click">
                    <MenuItem.Header>
                        <TextBlock Text="Export CSV..." Foreground="#1A2B3C" FontSize="12" FontFamily="Segoe UI"/>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Background="White" Click="Exit_Click">
                    <MenuItem.Header>
                        <TextBlock Text="Exit" Foreground="#1A2B3C" FontSize="12" FontFamily="Segoe UI"/>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
            <MenuItem Background="Transparent" Padding="10,1" Click="OpenSettings_Click">
                <MenuItem.Header>
                    <TextBlock Text="Setting" Foreground="#1A2B3C" FontSize="12" FontFamily="Segoe UI"/>
                </MenuItem.Header>
            </MenuItem>
        </Menu>

        <!-- ══════════════════════════════════════════════════════
             TOOLBAR
        ══════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="#1A3460"
                BorderBrush="#0F2040"
                BorderThickness="0,0,0,1"
                Height="50">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: action buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Start -->
                    <Button Style="{StaticResource GreenButton}"
                            Padding="14,5" Height="30" Margin="0,0,4,0"
                            IsEnabled="{Binding CanStart}"
                            Click="Start_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Start" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Stop (Pause) -->
                    <Button Style="{StaticResource TBtn}"
                            Padding="12,5" Height="30" Margin="0,0,4,0"
                            IsEnabled="{Binding CanPause}"
                            Click="Pause_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏸" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"
                                       Foreground="White"/>
                            <TextBlock Text="Stop" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- Play (Resume) -->
                    <Button Style="{StaticResource TBtn}"
                            Padding="12,5" Height="30" Margin="0,0,4,0"
                            IsEnabled="{Binding CanResume}"
                            Click="Resume_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"
                                       Foreground="White"/>
                            <TextBlock Text="Play" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- End -->
                    <Button Style="{StaticResource TBtn}"
                            Padding="12,5" Height="30" Margin="0,0,4,0"
                            IsEnabled="{Binding CanStop}"
                            Click="Stop_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="■" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0"
                                       Foreground="White"/>
                            <TextBlock Text="End" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- Clear -->
                    <Button Style="{StaticResource TBtn}" Click="ClearGraph_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↺" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="White"/>
                            <TextBlock Text="Clear" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- Save As -->
                    <Button Style="{StaticResource TBtn}" Click="SaveAs_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="White"/>
                            <TextBlock Text="Save" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>



                </StackPanel>

                <!-- CENTER: Connection + Recording status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10"
                             Fill="{Binding IsConnected, Converter={StaticResource ConnBrush}}"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{Binding IsConnected, Converter={StaticResource ConnBrush}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Disconnected"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Connected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="|" Foreground="#4A6080" FontSize="12" VerticalAlignment="Center" Margin="36,0"/>

                    <TextBlock Text="{Binding RecordingStatusText}"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#A8C0E8"/>
                                <Setter Property="Opacity"    Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecordingStatusText}" Value="Not Recording">
                                        <Setter Property="Foreground" Value="#EF5350"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RecordingStatusText}" Value="Recording">
                                        <Setter Property="Foreground" Value="#EF5350"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.15" Duration="0:0:0.6"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RecordingStatusText}" Value="Paused">
                                        <Setter Property="Foreground" Value="#FFA726"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RecordingStatusText}" Value="Recording Complete">
                                        <Setter Property="Foreground" Value="#43A047"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- RIGHT: Branding + Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,6,0">

                    <!-- Logo box -->
                    <Border Width="36" Height="36" CornerRadius="5"
                            Background="#1565C0" Margin="0,0,10,0">
                        <TextBlock Text="⊞" FontSize="20" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="White"/>
                    </Border>

                    <!-- Title text -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="LABTECH SCIENTIFIC"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="White" LineHeight="16"/>
                        <TextBlock Text="FILTER TESTER MONITOR"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrTeal}"/>
                    </StackPanel>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             MAIN CONTENT  — Sidebar | Content
        ══════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="195" MinWidth="160" MaxWidth="240"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────────────
                 LEFT SIDEBAR — Channel Stats
            ───────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="#1A3460"
                    BorderBrush="#0F2040"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <ScrollViewer.Template>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid Background="{TemplateBinding Background}">
                                <ScrollContentPresenter
                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           HorizontalAlignment="Right" Width="5"
                                           Minimum="0"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                           Panel.ZIndex="1"/>
                            </Grid>
                        </ControlTemplate>
                    </ScrollViewer.Template>
                    <StackPanel Margin="10,10,8,10">

                        <!-- ── Pressure at screen (P2) ── -->
                        <TextBlock Text="Pressure at screen (P2)" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <!-- P Start -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="P Start" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding P2_PStart}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PressureUnitLabel}" Style="{StaticResource StatUnit}"/>
                            <!-- P Max -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="P Max" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding P2_PMax}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PressureUnitLabel}" Style="{StaticResource StatUnit}"/>
                            <!-- ΔP -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Δ P" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding P2_DeltaP}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding PressureUnitLabel}" Style="{StaticResource StatUnit}"/>
                            <!-- FPV -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="FPV" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding P2_FPV}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding FpvUnitLabel}" Style="{StaticResource StatUnit}"/>
                        </Grid>

                        <Border Height="1" Background="White" Margin="0,6,0,8" Opacity="0.6"/>

                        <!-- ── Pump inlet Pressure (P1) ── -->
                        <TextBlock Text="Pump inlet Pressure (P1)" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="P Start" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding P1_PStart}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PressureUnitLabel}" Style="{StaticResource StatUnit}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="P End" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding P1_PEnd}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PressureUnitLabel}" Style="{StaticResource StatUnit}"/>
                        </Grid>

                        <Border Height="1" Background="White" Margin="0,6,0,8" Opacity="0.6"/>

                        <!-- ── Extruder (V1) ── -->
                        <TextBlock Text="Extruder (V1)" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="screw speed" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding V1_Speed}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SpeedUnitLabel}" Style="{StaticResource StatUnit}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Amp" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding I1_Amp}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="%" Style="{StaticResource StatUnit}"/>
                        </Grid>

                        <Border Height="1" Background="White" Margin="0,6,0,8" Opacity="0.6"/>

                        <!-- ── Temp at screen (T2) ── -->
                        <TextBlock Text="Temp at screen (T2)" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="T start" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding T2_TStart}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TemperatureUnitLabel}" Style="{StaticResource StatUnit}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="T end" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding T2_TEnd}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TemperatureUnitLabel}" Style="{StaticResource StatUnit}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="T max" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding T2_TMax}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TemperatureUnitLabel}" Style="{StaticResource StatUnit}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="T avg" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding T2_TAvg}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding TemperatureUnitLabel}" Style="{StaticResource StatUnit}"/>
                        </Grid>

                        <Border Height="1" Background="White" Margin="0,6,0,8" Opacity="0.6"/>

                        <!-- ── Pump inlet temp (T1) ── -->
                        <TextBlock Text="Pump inlet temp (T1)" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="T start" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding T1_TStart}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TemperatureUnitLabel}" Style="{StaticResource StatUnit}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="T end" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding T1_TEnd}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TemperatureUnitLabel}" Style="{StaticResource StatUnit}"/>
                        </Grid>

                        <Border Height="1" Background="White" Margin="0,6,0,8" Opacity="0.6"/>

                        <!-- ── Feed rate (V2) ── -->
                        <TextBlock Text="Feed rate (V2)" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Speed Gear" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding V2_Speed}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SpeedUnitLabel}" Style="{StaticResource StatUnit}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Amp" Style="{StaticResource StatLabel}"/>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValueBorder}">
                                <TextBlock Text="{Binding I2_Amp}" Style="{StaticResource StatBox}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="%" Style="{StaticResource StatUnit}"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                          Background="#0F2040" Cursor="SizeWE"/>

            <!-- ─────────────────────────────────────
                 RIGHT CONTENT — Legend + Chart + Form
            ───────────────────────────────────── -->
            <DockPanel Grid.Column="2" Background="{StaticResource BrBgDeep}">

                <!-- ── Chart Legend bar ── -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource BrChartBg}"
                        BorderBrush="{StaticResource BrFormBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="8,5">
                    <ItemsControl ItemsSource="{Binding LegendItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                                            Opacity="{Binding Visible, Converter={StaticResource BoolOpacity}}">
                                    <Border Width="22" Height="2" VerticalAlignment="Center"
                                            Background="{Binding ColorHex, Converter={StaticResource StrColor}}"
                                            Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="10" Foreground="#2C3E50"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ── Bottom form area ── -->
                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource BrFormBg}"
                        BorderBrush="{StaticResource BrFormBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 1 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- File Name -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="File Name" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <!-- Sample ID -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sample ID" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding SampleId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <!-- Base Polymer -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Base Polymer" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding BasePolymer, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <!-- Customer -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Customer" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <!-- Date -->
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="Date (dd/mm/yy)" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <!-- Operator -->
                            <StackPanel Grid.Column="10">
                                <TextBlock Text="Operator" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Operator, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Filter Screen size -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Filter Screen size" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding FilterScreenSize, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <!-- Feed Rate -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Feed Rate (g/min)" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding FeedRate, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <!-- Pressure Gear Pump Inlet -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{Binding PressureGearPumpInletLabel}" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding PressureGearPumpInlet, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <!-- Filtertest Unit Temp -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="{Binding FiltertestUnitTempLabel}" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding FiltertestUnitTemp, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <!-- Pigment Weight -->
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="Pigment Weight (g)" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding PigmentWeight, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <!-- Total Weight -->
                            <StackPanel Grid.Column="10">
                                <TextBlock Text="Total Weight (g)" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding TotalWeight, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── Melt summary bar ── -->
                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource BrFormBg}"
                        BorderBrush="{StaticResource BrFormBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <!-- Melt Pressure -->
                        <TextBlock Text="Melt Pressure"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrFormText}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Background="White" BorderBrush="{StaticResource BrFormBorder}"
                                BorderThickness="1" CornerRadius="3" Width="90">
                            <TextBlock Text="{Binding MeltPressure}"
                                       FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrFormText}"
                                       HorizontalAlignment="Right" Padding="8,4"/>
                        </Border>
                        <TextBlock Text="{Binding PressureUnitLabel}" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrFormText}" Margin="6,0,0,0"/>

                        <!-- Separator -->
                        <Border Width="1" Background="{StaticResource BrFormBorder}" Margin="40,0" Height="24"/>

                        <!-- Melt Temperature -->
                        <TextBlock Text="Melt Temperature"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrFormText}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Background="White" BorderBrush="{StaticResource BrFormBorder}"
                                BorderThickness="1" CornerRadius="3" Width="90">
                            <TextBlock Text="{Binding MeltTemperature}"
                                       FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrFormText}"
                                       HorizontalAlignment="Right" Padding="8,4"/>
                        </Border>
                        <TextBlock Text="{Binding TemperatureUnitLabel}" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrFormText}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── OxyPlot Chart (fills remaining space) ── -->
                <Border Background="{StaticResource BrChartBg}">
                    <Grid x:Name="ChartGrid">
                        <oxy:PlotView x:Name="PlotView"
                                      Model="{Binding PlotModel}"
                                      Background="Transparent"
                                      MouseMove="PlotView_MouseMove"
                                      MouseLeave="PlotView_MouseLeave">
                            <oxy:PlotView.DefaultTrackerTemplate>
                                <ControlTemplate>
                                    <oxy:TrackerControl Position="{Binding Position}"
                                                        LineExtents="{Binding PlotModel.PlotArea}"
                                                        Background="#FFFFF0"
                                                        BorderBrush="#A0A0A0"
                                                        BorderThickness="1">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="Black"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Margin="8,5"/>
                                    </oxy:TrackerControl>
                                </ControlTemplate>
                            </oxy:PlotView.DefaultTrackerTemplate>
                        </oxy:PlotView>

                        <!-- Crosshair + tracker tooltip (WPF overlay — no OxyPlot re-render) -->
                        <Canvas x:Name="CrosshairCanvas" IsHitTestVisible="False">
                            <Line x:Name="CrosshairV"
                                  Stroke="#909090" StrokeThickness="1"
                                  StrokeDashArray="4,3" Visibility="Collapsed"/>
                            <Line x:Name="CrosshairH"
                                  Stroke="#909090" StrokeThickness="1"
                                  StrokeDashArray="4,3" Visibility="Collapsed"/>
                            <Border Visibility="{Binding TrackerVisible, Converter={StaticResource BoolVis}}"
                                    Canvas.Left="{Binding TrackerX}"
                                    Canvas.Top="{Binding TrackerY}"
                                    Background="White" Opacity="0.95"
                                    BorderBrush="#B0C4D8" BorderThickness="1"
                                    CornerRadius="4" Padding="10,7">
                                <TextBlock Text="{Binding TrackerText}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="#1A2B3C" LineHeight="18"/>
                            </Border>
                        </Canvas>

                        <!-- Placeholder shown when no data -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasData, Converter={StaticResource InvBoolVis}}">
                            <TextBlock Text="Connect to PLC and click Start  —  or drag a CSV file here"
                                       FontSize="16" Foreground="#A0B0C0"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Drag &amp; drop a .csv log file to view historical data"
                                       FontSize="12" Foreground="#B8C8D8" Margin="0,6,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
